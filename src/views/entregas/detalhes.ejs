<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2>Detalhes da Entrega #<%= entrega.id %></h2>
        <a href="/entregas" class="text-decoration-none">← Voltar para listagem</a>
    </div>
    <span class="badge bg-primary fs-5"><%= entrega.status %></span>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light"><strong>Informações</strong></div>
            <div class="card-body">
                <p><strong>Descrição:</strong> <%= entrega.descricao %></p>
                <p><strong>Origem:</strong> <%= entrega.origem %></p>
                <p><strong>Destino:</strong> <%= entrega.destino %></p>
                <p><strong>Motorista Atribuído:</strong> <%= entrega.motoristaId ? 'ID ' + entrega.motoristaId : 'Nenhum' %></p>
                <div class="mt-4 pt-3 border-top">
                    <% if (entrega.status === 'CRIADA') { %>
                        <div class="bg-light p-3 rounded mb-3">
                            <form action="/entregas/<%= entrega.id %>/atribuir?_method=PATCH" method="POST" class="d-flex gap-2">
                                <select name="motoristaId" class="form-select" required>
                                    <option value="">Selecione um motorista ativo...</option>
                                    <% locals.motoristas && motoristas.forEach(m => { %>
                                        <option value="<%= m.id %>"><%= m.nome %></option>
                                    <% }) %>
                                </select>
                                <button type="submit" class="btn btn-primary px-4">Atribuir</button>
                            </form>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <form action="/entregas/<%= entrega.id %>/avancar?_method=PATCH" method="POST">
                                <button type="submit" class="btn btn-warning text-dark fw-bold">Avançar (Em Trânsito)</button>
                            </form>
                            <form action="/entregas/<%= entrega.id %>/cancelar?_method=PATCH" method="POST" onsubmit="return confirm('Tem certeza que deseja cancelar?');">
                                <button type="submit" class="btn btn-danger">Cancelar Entrega</button>
                            </form>
                        </div>
                    <% } %>

                    <% if (entrega.status === 'EM_TRANSITO') { %>
                        <form action="/entregas/<%= entrega.id %>/avancar?_method=PATCH" method="POST">
                            <button type="submit" class="btn btn-success fw-bold">Registrar como ENTREGUE</button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-light"><strong>Histórico de Eventos</strong></div>
            <ul class="list-group list-group-flush">
                <% entrega.historico.forEach(evento => { %>
                    <li class="list-group-item">
                        <small class="text-muted"><%= new Date(evento.data).toLocaleString('pt-BR') %></small><br>
                        <%= evento.descricao %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </div>
</div>