<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestão de Entregas</h2>
    <a href="/entregas/nova" class="btn btn-primary">Nova Entrega</a>
</div>

<form action="/entregas" method="GET" class="mb-4 d-flex gap-2 w-50">
    <select name="status" class="form-select">
        <option value="">Todos os status</option>
        <option value="CRIADA" <%= locals.statusAtual === 'CRIADA' ? 'selected' : '' %>>CRIADA</option>
        <option value="EM_TRANSITO" <%= locals.statusAtual === 'EM_TRANSITO' ? 'selected' : '' %>>EM TRÂNSITO</option>
        <option value="ENTREGUE" <%= locals.statusAtual === 'ENTREGUE' ? 'selected' : '' %>>ENTREGUE</option>
        <option value="CANCELADA" <%= locals.statusAtual === 'CANCELADA' ? 'selected' : '' %>>CANCELADA</option>
    </select>
    <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Descrição</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (entregas.length === 0) { %>
                    <tr><td colspan="4" class="text-center py-4 text-muted">Nenhuma entrega encontrada.</td></tr>
                <% } else { %>
                    <% entregas.forEach(e => { %>
                        <tr>
                            <td class="align-middle"><%= e.id %></td>
                            <td class="align-middle"><%= e.descricao %></td>
                            <td class="align-middle">
                                <span class="badge bg-primary"><%= e.status %></span>
                            </td>
                            <td class="align-middle">
                                <a href="/entregas/<%= e.id %>" class="btn btn-sm btn-info text-white">Detalhes</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>