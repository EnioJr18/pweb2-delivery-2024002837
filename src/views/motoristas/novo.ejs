<div class="mb-4">
    <h2>Cadastrar Motorista</h2>
    <a href="/motoristas" class="text-decoration-none">← Voltar para a listagem</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form action="/motoristas" method="POST">
            <div class="mb-3">
                <label for="nome" class="form-label">Nome Completo</label>
                <!-- Usamos o locals.oldData para repopular o input em caso de erro de CPF duplicado -->
                <input type="text" class="form-control" id="nome" name="nome" 
                       value="<%= locals.oldData ? oldData.nome : '' %>" required>
            </div>
            
            <div class="mb-3">
                <label for="cpf" class="form-label">CPF</label>
                <input type="text" class="form-control" id="cpf" name="cpf" 
                       value="<%= locals.oldData ? oldData.cpf : '' %>" required>
            </div>
            
            <div class="mb-3">
                <label for="placaVeiculo" class="form-label">Placa do Veículo (Opcional)</label>
                <input type="text" class="form-control" id="placaVeiculo" name="placaVeiculo" 
                       value="<%= locals.oldData ? oldData.placaVeiculo : '' %>">
            </div>
            
            <div class="mt-4">
                <button type="submit" class="btn btn-success">Salvar Motorista</button>
            </div>
        </form>
    </div>
</div>